# SafeOps Production Environment Variables Template
# NEVER commit actual values. Supply these via AWS Secrets Manager or EC2/ECS environment.
# NEVER use .env files in production - use AWS Secrets Manager or IAM roles.

SPRING_PROFILES_ACTIVE=prod

# Database - AWS RDS
# RDS endpoint: safeops-db.cbam0y2e0rb8.ap-south-1.rds.amazonaws.com
DB_HOST=
DB_PORT=5432
DB_NAME=safeops
DB_USERNAME=
DB_PASSWORD=

# Firebase
# Use FIREBASE_CREDENTIALS_JSON (injected from AWS Secrets Manager)
FIREBASE_CREDENTIALS_JSON=

# CORS - restrict to your production domains
CORS_ALLOWED_ORIGINS=

# AWS - Do NOT set AWS_ACCESS_KEY_ID or AWS_SECRET_ACCESS_KEY here
# Use IAM Instance Roles or ECS Task Roles instead
AWS_REGION=ap-south-1
AWS_S3_BUCKET_NAME=
