# SafeOps Backend Environment Variables
# Copy this file to .env.local for local development
# NEVER commit .env.local or any file with real credentials

# Spring Profile
SPRING_PROFILES_ACTIVE=local

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=safeops_local
DB_USERNAME=safeops_local
DB_PASSWORD=

# Firebase
# Option 1: Path to service account JSON file
FIREBASE_CREDENTIALS_PATH=
# Option 2: Full JSON content as environment variable (for production/CI)
FIREBASE_CREDENTIALS_JSON=

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://10.0.2.2:8080

# AWS (for production only - use IAM roles in AWS, not keys)
AWS_REGION=ap-south-1
AWS_S3_BUCKET_NAME=
